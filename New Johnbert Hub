-- Tag iya kung kinsa ang saktong OK button
local correctButton = nil

-- Function para sa SHUFFLE
local function ShuffleButtons()
    local positions = {
        UDim2.new(0, 0, 0, 0),
        UDim2.new(0, 0, 0, 50)
    }
    
    local randPos1 = math.random(1, 2)
    local randPos2 = (randPos1 == 1) and 2 or 1
    
    OkButton1.Position = positions[randPos1]
    OkButton2.Position = positions[randPos2]
    
    -- Randomly pili kung hain ang sakto
    if math.random(1, 2) == 1 then
        correctButton = OkButton1
    else
        correctButton = OkButton2
    end
end

-- BOUNCE ANIMATION sa paggawas
MainFrame.Visible = true
MainFrame.Size = UDim2.new(0, 0, 0, 0)
local bounceTween = TweenService:Create(MainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Size = UDim2.new(0, 310, 0, 330)
})
bounceTween:Play()

ShuffleButtons()

-- Logic sa pagpindot
local function HandleClick(clickedButton)
    pcall(function()
        local ClickSound = Instance.new("Sound")
        ClickSound.SoundId = "rbxassetid://12221967"
        ClickSound.Volume = 1.0
        ClickSound.Parent = ProtectedGui
        ClickSound:Play()
    end)
    
    if clickedButton == correctButton then
        -- Sakto ang napindot: Mawala ang UI nga walay buhaton
        NoticeText.TextColor3 = Color3.fromRGB(0, 255, 120)
        NoticeText.Text = "Salamat! Ge update pa ang SCRIPT..."
        task.wait(1)
        
        local fadeOut = TweenService:Create(MainFrame, TweenInfo.new(0.4), {BackgroundTransparency = 1})
        fadeOut:Play()
        fadeOut.Completed:Connect(function()
            ScreenGui:Destroy()
        end)
    else
        -- Sayop ang napindot: Ma-kick dayon
        pcall(function()
            local ErrorSound = Instance.new("Sound")
            ErrorSound.SoundId = "rbxassetid://138194950178546"
            ErrorSound.Volume = 1.0
            ErrorSound.Parent = ProtectedGui
            ErrorSound.ErrorSound:Play()
        end)
        
        NoticeText.TextColor3 = Color3.fromRGB(255, 50, 50)
        NoticeText.Text = "Mali ang imong napili nga OK! Gi-kick ka na ni JOHNBERT."
        task.wait(1.5)
        
        pcall(function()
            LocalPlayer:Kick("Gipislit nimo ang sayop nga OK button! Na-kick ka ni JOHNBERT.")
        end)
    end
end

OkButton1.MouseButton1Click:Connect(function()
    HandleClick(OkButton1)
end)

OkButton2.MouseButton1Click:Connect(function()
    HandleClick(OkButton2)
end)
