task.spawn(function()
    while MainFrame.Parent do
        local t = os.date("*t")
        local currentSeconds = t.hour * 3600 + t.min * 60 + t.sec
        local diff = (23 * 3600) - currentSeconds
        if diff < 0 then diff = diff + 86400 end
        local hours = math.floor(diff / 3600)
        local minutes = math.floor((diff % 3600) / 60)
        local seconds = diff % 60
        if CountdownDesc and CountdownDesc.Parent then
            CountdownDesc.Text = string.format("Countdown to 11:00 PM: %02d:%02d:%02d", hours, minutes, seconds)
        end
        task.wait(1)
    end
end)

