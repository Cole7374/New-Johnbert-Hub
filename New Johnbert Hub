local CountdownParagraph = Tabs.Creator:AddParagraph({
    Title = "Next Script Update Countdown",
    Content = "Loading timer..."
})

task.spawn(function()
    while true do
        local now = os.time()
        local targetHour = 22
        local targetMin = 0
        local dateTable = os.date("*t", now)
        
        local targetTable = {
            year = dateTable.year,
            month = dateTable.month,
            day = dateTable.day,
            hour = targetHour,
            min = targetMin,
            sec = 0
        }
        local targetTime = os.time(targetTable)
        
        if now > targetTime then
            targetTable.day = targetTable.day + 1
            targetTime = os.time(targetTable)
        end
        
        local diff = targetTime - now
        
        if diff > 0 then
            local hours = math.floor(diff / 3600)
            local minutes = math.floor((diff % 3600) / 60)
            local seconds = diff % 60
            CountdownParagraph:SetDesc(string.format("Update In Alas 10:00: %02dh %02dm %02ds remaining", hours, minutes, seconds))
        else
            CountdownParagraph:SetDesc("Update time reached (Alas 10:00)!")
        end
        task.wait(1)
    end
end)

