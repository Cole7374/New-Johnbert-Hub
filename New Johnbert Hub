-- Draggable Logic with Screen Boundary Restriction (Bawal maka-gawas sa screen)
local dragging = false
local dragInput, dragStart, startPos

ToggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ToggleButton.AbsolutePosition
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        local newX = startPos.X + delta.X
        local newY = startPos.Y + delta.Y
        
        -- Kuhaon ang size sa screen aron dili gyud ma-awas
        local viewportSize = ToggleGui.AbsoluteSize
        local maxX = viewportSize.X - ToggleButton.AbsoluteSize.X
        local maxY = viewportSize.Y - ToggleButton.AbsoluteSize.Y
        
        -- I-clamp ang posisyon aron naa ra gyud sa sulod sa screen
        newX = math.clamp(newX, 0, maxX)
        newY = math.clamp(newY, 0, maxY)
        
        ToggleButton.Position = UDim2.new(0, newX, 0, newY)
    end
end)

