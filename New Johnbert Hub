-- Bounded Draggable Script para dili makagawas sa screen
local dragging, dragInput, dragStart, startPos
local LocalPlayer = Players.LocalPlayer

ToggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ToggleButton.AbsolutePosition
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

ToggleButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        local newX = startPos.X + delta.X
        local newY = startPos.Y + delta.Y
        
        local screenSize = ToggleGui.AbsoluteSize
        local btnSize = ToggleButton.AbsoluteSize
        
        newX = math.clamp(newX, 0, screenSize.X - btnSize.X)
        newY = math.clamp(newY, 0, screenSize.Y - btnSize.Y)
        
        ToggleButton.Position = UDim2.new(0, newX, 0, newY)
    end
end)

task.spawn(function()
    while ToggleButton and ToggleButton.Parent do
        for i = 0, 1, 0.005 do
            if not ToggleButton or not ToggleButton.Parent then break end
            UIStroke.Color = Color3.fromHSV(i, 1, 1)
            task.wait(0.03)
        end
    end
end)

