AddButton(TabPrivateServer, "Join Available Server (Player > 0)", function()
    ServerStatusDesc.Text = "Searching for a valid server..."
    task.spawn(function()
        local success, err = pcall(function()
            local cursor = ""
            local servers = {}
            -- Pagkuha sa listahan sa mga active servers sa Roblox API
            repeat
                local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
                local req = game:HttpGet(url)
                local data = HttpService:JSONDecode(req)
                for _, s in ipairs(data.data) do
                    -- Sigurohon nga ang playing > 0 ug dili ang kasamtangang server
                    if s.playing and s.playing > 0 and s.playing < s.maxPlayers and s.id ~= game.JobId then
                        table.insert(servers, s.id)
                    end
                end
                cursor = data.nextPageCursor
            until #servers > 0 or not cursor

            if #servers > 0 then
                ServerStatusDesc.Text = "Server found! Teleporting..."
                local randomServerId = servers[math.random(1, #servers)]
                TeleportService:TeleportToPlaceInstance(game.PlaceId, randomServerId, Players.LocalPlayer)
            else
                ServerStatusDesc.Text = "No valid servers found with > 0 players."
            end
        end)
        if not success then
            ServerStatusDesc.Text = "Teleport failed. Try again."
        end
    end)
end)

