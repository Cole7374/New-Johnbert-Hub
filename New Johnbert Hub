-- Countdown Paragraph (Target: 22:00 / 10:00 PM)
local CountdownParagraph = Tabs.Settings:AddParagraph({
    Title = "Script Update Countdown",
    Content = "Loading timer..."
})

task.spawn(function()
    while true do
        local now = os.time()
        local targetHour = 22 -- 22:00 o'clock = 10:00 PM sa gabii
        local targetMin = 0
        local dateTable = os.date("*t", now)
        
        local targetTable = {
            year = dateTable.year,
            month = dateTable.month,
            day = dateTable.day,
            hour = targetHour,
            min = targetMin,
            sec = 0
        }
        local targetTime = os.time(targetTable)
        
        if now > targetTime then
            targetTable.day = targetTable.day + 1
            targetTime = os.time(targetTable)
        end
        
        local diff = targetTime - now
        
        if diff > 0 then
            local hours = math.floor(diff / 3600)
            local minutes = math.floor((diff % 3600) / 60)
            local seconds = diff % 60
            CountdownParagraph:SetDesc(string.format("Update In 10:00 PM: %02dh %02dm %02ds remaining", hours, minutes, seconds))
        else
            CountdownParagraph:SetDesc("Update time reached (10:00 PM)!")
        end
        task.wait(1)
    end
end)

