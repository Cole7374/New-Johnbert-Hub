    d.Text = desc
    d.TextColor3 = Color3.fromRGB(160, 195, 235)
    d.TextSize = 8
    d.TextXAlignment = Enum.TextXAlignment.Left
    d.ZIndex = 13

    table.insert(allElements, {Object = f, Text = string.lower(title .. " " .. desc)})
    return f
end

local function AddButton(tab, name, callback)
    local btn = Instance.new("TextButton", tab)
    btn.BackgroundColor3 = Color3.fromRGB(30, 120, 160)
    btn.BackgroundTransparency = 0.4
    btn.Size = UDim2.new(1, 0, 0, 24)
    btn.Font = Enum.Font.GothamBold
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 9
    btn.ZIndex = 13
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    RegisterThemeElement(btn, "Button")

    btn.MouseButton1Click:Connect(function()
        PlayClickSound()
        callback()
    end)

    table.insert(allElements, {Object = btn, Text = string.lower(name)})
    return btn
end

