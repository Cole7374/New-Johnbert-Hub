    t.TextColor3 = Color3.fromRGB(230, 245, 255)
    t.TextSize = 9
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.ZIndex = 13

    local d = Instance.new("TextLabel", f)
    d.BackgroundTransparency = 1
    d.Position = UDim2.new(0, 8, 0, 16)
    d.Size = UDim2.new(1, -16, 0, 16)
