local pages = {}
local activePage = nil
local allElements = {}
local themeObjects = { Frames = {}, Buttons = {}, Strokes = {} }

local function RegisterThemeElement(obj, typeName)
    if typeName == "Frame" then table.insert(themeObjects.Frames, obj)
    elseif typeName == "Button" then table.insert(themeObjects.Buttons, obj)
    elseif typeName == "Stroke" then table.insert(themeObjects.Strokes, obj) end
end

local function ApplyThemeColors(bgCol, btnCol, strokeCol)
    for _, f in ipairs(themeObjects.Frames) do if f and f.Parent then f.BackgroundColor3 = bgCol end end
    for _, b in ipairs(themeObjects.Buttons) do if b and b.Parent then b.BackgroundColor3 = btnCol end end
    for _, s in ipairs(themeObjects.Strokes) do if s and s.Parent then s.Color = strokeCol end end
    if MainFrame and MainFrame.Parent then MainFrame.BackgroundColor3 = bgCol end
    if SearchBox and SearchBox.Parent then SearchBox.BackgroundColor3 = bgCol end
    if Sidebar and Sidebar.Parent then Sidebar.BackgroundColor3 = bgCol end
    if MainStroke and MainStroke.Parent then MainStroke.Color = strokeCol end
    if SearchStroke and SearchStroke.Parent then SearchStroke.Color = strokeCol end
end

local rainbowConnection = nil
local function SetTheme(themeName)
    if rainbowConnection then rainbowConnection:Disconnect() rainbowConnection = nil end
    if themeName == "Rainbow" then
        rainbowConnection = RunService.RenderStepped:Connect(function()
            local hue = (tick() % 5) / 5
            ApplyThemeColors(Color3.fromRGB(20, 20, 25), Color3.fromHSV(hue, 0.8, 1), Color3.fromHSV(hue, 0.7, 0.9))
        end)
    elseif themeName == "White" then ApplyThemeColors(Color3.fromRGB(240, 240, 245), Color3.fromRGB(210, 210, 220), Color3.fromRGB(150, 150, 160))
    elseif themeName == "Dark" then ApplyThemeColors(Color3.fromRGB(15, 15, 20), Color3.fromRGB(30, 30, 40), Color3.fromRGB(70, 70, 90))
    elseif themeName == "Cherry" then ApplyThemeColors(Color3.fromRGB(40, 15, 25), Color3.fromRGB(140, 40, 75), Color3.fromRGB(220, 80, 120))
    elseif themeName == "Cyan" then ApplyThemeColors(Color3.fromRGB(15, 35, 45), Color3.fromRGB(30, 120, 160), Color3.fromRGB(70, 180, 220))
    elseif themeName == "Emerald" then ApplyThemeColors(Color3.fromRGB(15, 40, 30), Color3.fromRGB(30, 140, 90), Color3.fromRGB(70, 220, 140)) end
end

local function CreateTab(name)
    local TabBtn = Instance.new("TextButton", Sidebar)
    TabBtn.BackgroundColor3 = Color3.fromRGB(30, 120, 160)
    TabBtn.BackgroundTransparency = 0.5
    TabBtn.Size = UDim2.new(1, 0, 0, 26)
    TabBtn.Font = Enum.Font.GothamBold
    TabBtn.Text = name
    TabBtn.TextColor3 = Color3.fromRGB(220, 235, 255)
    TabBtn.TextSize = 9
    TabBtn.ZIndex = 12
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 4)
    RegisterThemeElement(TabBtn, "Button")

    local Page = Instance.new("ScrollingFrame", ContentContainer)
    Page.BackgroundTransparency = 1
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.CanvasSize = UDim2.new(0, 0, 0, 0)
    Page.ScrollBarThickness = 3
    Page.ScrollingEnabled = true
    Page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Page.Visible = false
    Page.BorderSizePixel = 0
    Page.ZIndex = 12

    local PageLayout = Instance.new("UIListLayout", Page)
    PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    PageLayout.FillDirection = Enum.FillDirection.Vertical
    PageLayout.Padding = UDim.new(0, 4)

    TabBtn.MouseButton1Click:Connect(function()
        PlayClickSound()
        for _, p in pairs(pages) do p.Visible = false end
        Page.Visible = true
        activePage = Page
    end)

    if not activePage then
        Page.Visible = true
        activePage = Page
    end

    table.insert(pages, Page)
    return Page
end

local function AddParagraph(tab, title, desc)
    local f = Instance.new("Frame", tab)
    f.BackgroundColor3 = Color3.fromRGB(20, 50, 70)
    f.BackgroundTransparency = 0.5
    f.Size = UDim2.new(1, 0, 0, 36)
    f.ZIndex = 13
