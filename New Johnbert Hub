local function CreateTab(name)
    local TabButton = Instance.new("TextButton")
    TabButton.Parent = Sidebar
    TabButton.BackgroundColor3 = Color3.fromRGB(18, 40, 70)
    TabButton.BackgroundTransparency = 0.5
    TabButton.Size = UDim2.new(0, 97, 0, 24)
    TabButton.Font = Enum.Font.GothamMedium
    TabButton.Text = name
    TabButton.TextColor3 = Color3.fromRGB(220, 235, 255)
    TabButton.TextSize = 10

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 5)
    BtnCorner.Parent = TabButton

    local TabPage = Instance.new("ScrollingFrame")
    TabPage.Parent = ContentArea
    TabPage.BackgroundTransparency = 1
    TabPage.Size = UDim2.new(1, 0, 1, 0)
    TabPage.CanvasSize = UDim2.new(0, 0, 2.0, 0)
    TabPage.ScrollBarThickness = 2
    TabPage.Visible = false
    TabPage.BorderSizePixel = 0

    local PageLayout = Instance.new("UIListLayout")
    PageLayout.Parent = TabPage
    PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    PageLayout.Padding = UDim.new(0, 5)

    TabButton.MouseButton1Click:Connect(function()
        for _, page in pairs(tabsList) do
            page.Visible = false
        end
        TabPage.Visible = true
        
        pcall(function()
            local ClickSound = Instance.new("Sound")
            ClickSound.SoundId = "rbxassetid://12221967"
            ClickSound.Volume = 1.0
            ClickSound.Parent = ProtectedGui
            ClickSound:Play()
        end)
    end)

    if not activeTab then
        TabPage.Visible = true
        activeTab = TabPage
    end

    table.insert(tabsList, TabPage)
    return TabPage
end

