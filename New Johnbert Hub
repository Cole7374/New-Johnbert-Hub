-- Live Timer Update Loop
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            -- Christmas Countdown (Dec 25, 2026)
            local targetXmas = os.time({year=2026, month=12, day=25, hour=0, min=0, sec=0})
            local diffXmas = targetXmas - os.time()
            if diffXmas > 0 then
                local days = math.floor(diffXmas / 86400)
                local hours = math.floor((diffXmas % 86400) / 3600)
                local mins = math.floor((diffXmas % 3600) / 60)
                local secs = diffXmas % 60
                xmassLabel:SetName(string.format("🎄 Xmas: %dd %dh %dm %ds", days, hours, mins, secs))
            else
                xmassLabel:SetName("🎄 Merry Christmas!")
            end

            -- Saturday 11:00 PM Countdown
            local currTime = os.time()
            local dateTable = os.date("*t", currTime)
            local daysUntilSat = (7 - dateTable.wday) % 7
            if daysUntilSat == 0 and (dateTable.hour > 23 or (dateTable.hour == 23 and dateTable.min > 0)) then
                daysUntilSat = 7
            end
            local targetSat = os.time({
                year = dateTable.year,
                month = dateTable.month,
                day = dateTable.day + daysUntilSat,
                hour = 23,
                min = 0,
                sec = 0
            })
            local diffSat = targetSat - currTime
            if diffSat > 0 then
                local d = math.floor(diffSat / 86400)
                local h = math.floor((diffSat % 86400) / 3600)
                local m = math.floor((diffSat % 3600) / 60)
                local s = diffSat % 60
                satLabel:SetName(string.format("⏰ Sat 11PM: %dd %dh %dm %ds", d, h, m, s))
            else
                satLabel:SetName("⏰ Sat 11:00 PM Na!")
            end
        end)
    end
end)

